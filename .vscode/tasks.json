{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C++: build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "windows": {
                "command": "C:/msys64/ucrt64/bin/g++.exe",
                "args": [
                    "-std=c++17",
                    "-Wall",
                    "-Wextra",
                    "-g",
                    "${file}",
                    "-o",
                    "${fileDirname}/${fileBasenameNoExtension}.exe"
                ],
                "options": {
                    "cwd": "${fileDirname}",
                    "env": {
                        "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                    }
                }
            },
            "linux": {
                "command": "g++"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "macOS 使用 Apple Clang；Windows 使用 MSYS2 UCRT64；Linux 使用 g++。"
        },
