{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "C++: build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Compile the active C++ file with MSYS2 UCRT64 g++."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:/msys64/ucrt64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "C++: build lesson12",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17", "-Wall", "-Wextra", "-g",
                "${workspaceFolder}/exercises/lesson12/main.cpp",
                "${workspaceFolder}/exercises/lesson12/Player.cpp",
                "${workspaceFolder}/exercises/lesson12/Weapon.cpp",
                "-o", "${workspaceFolder}/exercises/lesson12/lesson12.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/exercises/lesson12",
                "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
            },
            "problemMatcher": ["$gcc"],
            "detail": "一起编译第12课的main、Player与Weapon，不加入其他课程。"
        },
        {
            "label": "启动学习网站",
            "type": "shell",
            "command": "npm",
            "windows": { "command": "npm.cmd" },
            "args": [
                "run",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "detail": "启动引擎学堂：http://127.0.0.1:5173；Ctrl+C停止后再同步Git。"
        }
    ]
